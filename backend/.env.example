# 머니로그랩 환경 설정 템플릿 (Local Environment Configuration)

# 서버 포트
PORT=5000

# 다람쥐 연구원 로기 AI 엔진 구동을 위한 Gemini API 키 (필수)
# 발급처: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 뉴스레터 발송 서비스 (옵션 - 입력하지 않으면 콘솔 로그로 메일이 대체 모의 발송됩니다)
# 발급처: https://resend.com/
RESEND_API_KEY=YOUR_RESEND_API_KEY
SENDER_EMAIL=newsletter@moneyloglab.com

# 비밀 관리자 페이지 (/admin-secret) 접근 암호 (기본값: rogi1234)
ADMIN_PASSWORD=rogi1234

# JWT 보안 토큰 서명 키 (아무 문자열이나 입력)
JWT_SECRET=rogi_secret_key_squirrel_acorn_2026
